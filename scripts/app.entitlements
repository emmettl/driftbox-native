<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app under the hardened runtime, as a notarised one must be. It loads other developers'
     code into itself — the Audio Units and VST 3 plug-ins the rack hosts, signed by their own teams
     or by nobody — which library validation would refuse, so that is one exception. The other is
     the microphone, for the rack's Audio Input module: the hardened runtime keeps an app from
     audio input unless it says it listens, as the sandbox does with the same key. -->
<plist version="1.0"><dict>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
</dict></plist>
