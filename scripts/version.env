# The version and build a bundle carries, the app's and its extension's both: read by
# scripts/bundle-app.sh, and checked by scripts/release.py. Windows' programs carry it too, in the
# resources scripts/windows-resources.mjs writes from it: run that after changing it. A version is
# major.minor.patch, a build a whole number that goes up with every release.
DRIFTBOX_VERSION=0.1.0
DRIFTBOX_BUILD=1
